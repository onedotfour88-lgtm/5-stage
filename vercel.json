{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/checks", "destination": "/api/operations-public?view=checks" },
    { "source": "/api/notes", "destination": "/api/memos" },
    { "source": "/api/memos/:id", "destination": "/api/memos?id=:id" }
  ]
}
